# Variables para Docker Compose (copiar a un archivo llamado .env para cambiarlas).
# Si no existe .env se usan los valores por defecto de docker-compose.yml.

DB_NAME=sgci
DB_USER=postgres
DB_PASSWORD= #Pongan el de ustedes que esta en el Backend 
SECRET_KEY= #Igual 
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origen(es) del frontend permitidos por el backend (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dirección de la API que usa el navegador (se incorpora al compilar el frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000